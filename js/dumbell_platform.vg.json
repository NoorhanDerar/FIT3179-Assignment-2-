{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Do Google and TripAdvisor agree on each city?"},
  "width": 600,
  "height": 340,
  "data": {"url": "data/city_by_source.csv"},
  "transform": [
    {"joinaggregate": [{"op": "min", "field": "n_restaurants", "as": "min_rest"}], "groupby": ["city"]},
    {"calculate": "datum.min_rest < 20 ? datum.city + ' *' : datum.city", "as": "label"},
    {"pivot": "source", "value": "avg_rating", "groupby": ["label"]}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "color": "#B8C2D3", "strokeWidth": 4, "strokeCap": "round"},
      "encoding": {
        "y": {"field": "label", "type": "nominal", "sort": {"field": "TripAdvisor", "order": "descending"}, "title": null},
        "x": {"field": "Google", "type": "quantitative", "scale": {"domain": [3.8, 4.8]}, "title": "Average star rating",
              "axis": {"values": [3.8, 4.0, 4.2, 4.4, 4.6, 4.8], "format": ".1f"}},
        "x2": {"field": "TripAdvisor"}
      }
    },
    {
      "transform": [{"fold": ["Google", "TripAdvisor"], "as": ["platform", "rating"]}],
      "mark": {"type": "point", "filled": true, "size": 160, "opacity": 1, "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "y": {"field": "label", "type": "nominal", "sort": {"field": "TripAdvisor", "order": "descending"}},
        "x": {"field": "rating", "type": "quantitative"},
        "color": {"field": "platform", "type": "nominal", "title": "Platform",
                  "scale": {"domain": ["Google", "TripAdvisor"], "range": ["#2563EB", "#D9480F"]}},
        "tooltip": [
          {"field": "label", "title": "City"}, {"field": "platform", "title": "Platform"},
          {"field": "rating", "type": "quantitative", "format": ".2f", "title": "Average stars"}
        ]
      }
    },
    {
      "transform": [
        {"calculate": "datum.TripAdvisor - datum.Google", "as": "gap"},
        {"filter": "abs(datum.gap) >= 0.3"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 12, "fontWeight": 700, "color": "#0F1B2D"},
      "encoding": {
        "y": {"field": "label", "type": "nominal", "sort": {"field": "TripAdvisor", "order": "descending"}},
        "x": {"field": "TripAdvisor", "type": "quantitative"},
        "text": {"field": "gap", "type": "quantitative", "format": "+.2f"}
      }
    }
  ]
}
